{% extends "skeleton" %}

{% block body_content %}
<h1>Transaction</h1>
<p><strong>id/type:</strong> {{ txn.id|e }}/{{ txn.type|e }}</p>
<p><strong>state:</strong> {{ txn.state|e }}</p>
<p><strong>comment:</strong> {{ comment|e }}</p>
<p><strong>creator:</strong>
{% if creator.agent %}{{ creator.agent.name|e }}{% endif %}
{% if creator.user %}({{ creator.user.name|e }}){% endif %}
</p>
<h2>Linked cases</h2>
<div>
<ul>
{% for case_id in cases %}
<li><pre><a {{ {'href': '/case/view/%s' % case_id}|xmlattr }}>{{ case_id|e }}</a></pre></li>
{% endfor %}
</ul>
</div>
{%- endblock %}
