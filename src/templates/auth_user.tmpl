{% extends "skeleton" %}

{% block body_content %}
<h1>User</h1>
{% if authenticated|default(False) %}

<div class="user_view">
<h3>General information</h3>
<table>
<tr><th>Name</th><td>{{ user.name|default('-')|e }}</td></tr>
<tr><th>Email</th><td>{{ user.email|default('-')|e }}</td></tr>
</table>
</div>

<div class="fido2">
<h3>FIDO2 credentials</h3>
<table>
<thead>
<tr><th>Name</th><th>AAGUID</th></tr>
</thead>
<tbody><tr><td></td><td></td></tr></tbody><!-- empty row is necessary to conform w3c -->
</table>
<p><button type="button" id="fido2_register">Add this device</button></p>

<div style="display: none;" id="fido2_rename" title="Rename the FIDO2 credential">
<p class="validateTips">The name is required.</p>
<form action="">
<table>
<tr><td><label for="fido2_rename__credential_name">Name</label></td><td><input type="text" name="credential_name" value="" size="32" maxlength="128" id="fido2_rename__credential_name" class="text ui-widget-content ui-corner-all" /></td></tr>
</table>
<!-- Allow form submission with keyboard without duplicating the dialog button -->
<div style="display: none;"><input type="submit" /></div>
</form>
</div>

<div style="display: none;" id="fido2_remove_confirm" title="Remove the FIDO2 credential?">
<p><span class="ui-icon ui-icon-alert" style="float:left; margin:0 7px 20px 0;"></span>The credential will be permanently removed and you may be unable to authenticate with FIDO2 afterwards. Are you sure?</p>
</div>
</div>
<script>
// raw script begin <![CDATA[
function fido2_decode(value) {
    const padded = value + "=".repeat((4 - value.length % 4) % 4);
    const binary = atob(padded.replace(/-/g, "+").replace(/_/g, "/"));
    return Uint8Array.from(binary, character => character.charCodeAt(0));
}
function fido2_encode(value) {
    const bytes = new Uint8Array(value);
    let binary = "";
    for (const byte of bytes) binary += String.fromCharCode(byte);
    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}
$(function () {

var user_id = {{ user.id|string|json }};

$("#fido2_register").click(function () {
    $.getJSON("/auth/ext/fido2?op=register", function (options) {
        options.challenge = fido2_decode(options.challenge);
        if (options.user) options.user.id = fido2_decode(options.user.id);
        if (options.excludeCredentials) options.excludeCredentials.forEach(function (c) { c.id = fido2_decode(c.id); });
        navigator.credentials.create({publicKey: options}).then(function (credential) {
            var response = credential.response;
            var encode = fido2_encode;
            $.ajax({method: "POST", url: "/auth/ext/fido2", contentType: "application/json",
                data: JSON.stringify({response: {clientDataJSON: encode(response.clientDataJSON), attestationObject: encode(response.attestationObject)}}),
                success: function () { window.location.reload(); }});
        });
    });
});

// own FIDO2 credentials can be renamed and removed here
var fido2_table = $("div.fido2 table:first");
var fido2_table_customRowButtons = new Array();

var fido2_manage = function (action, args, success_callback, failure_callback) {
    $.ajax({
        method: "POST",
        url: sprintf("/user/update/%s", user_id),
        contentType: "application/json",
        data: JSON.stringify({op: sprintf("fido2/%s", action), args: args}),
        dataType: "json",
        success: function (data, textStatus, jqXHR) {
            success_callback();
        },
        error: function (jqXHR, textStatus, errorThrown) {
            failure_callback();
        },
        timeout: 3000
    });
};
var fido2_rename = function (credential_id, credential_name, success_callback, failure_callback) {
    return fido2_manage("rename", {id: credential_id, name: credential_name}, success_callback, failure_callback);
};
var fido2_remove = function (credential_id, success_callback, failure_callback) {
    return fido2_manage("remove", {id: credential_id, confirm: true}, success_callback, failure_callback);
};

// transform fido2_rename html block to popup dialog
var show_fido2_rename_dialog = function (credential_name, confirm_callback /* credential_name, finalize_callback */) {
    var thedialog = $("div#fido2_rename");

    thedialog.find("form input[type=text][name=credential_name]").val(credential_name);

    var finalize = function () {
        thedialog.dialog("close");
    };

    var confirm = function () {
        var new_name = $.trim(thedialog.find("form input[type=text][name=credential_name]").val());
        if (new_name == "") {
            thedialog.find("form input[type=text][name=credential_name]").css("border-color", "red");
            return;
        }
        confirm_callback(new_name, finalize);
    };

    thedialog.dialog({
        autoOpen: false,
        height: 220,
        width: 400,
        modal: true,
        buttons: [
            {text: "Rename the credential", click: function () {
                confirm();
            }},
            {text: "Cancel", click: function () {
                thedialog.dialog("close");
            }},
        ],
        close: function () {
            thedialog.find("form").trigger("reset");
            thedialog.find("form").off("submit");
            thedialog.find("form input[type=text][name=credential_name]").css("border-color", "");
        }
    });

    thedialog.find("form").on("submit", function (event) {
        event.preventDefault();
        confirm();
    });

    thedialog.dialog("open");
};

fido2_table_customRowButtons.push({
    uiButton: { icons: { primary: "ui-icon-pencil" }, text: false },
    btnAttr: { title: "Rename the credential" },
    atTheFront: true,
    click: function (evt, uniqueIndex, rowData) {
        var rowIndex = fido2_table.appendGrid("getRowIndex", uniqueIndex);
        var credential_id = fido2_table.appendGrid("getCtrlValue", "credential_id", rowIndex);
        var credential_name = fido2_table.appendGrid("getCtrlValue", "credential_name", rowIndex);
        show_fido2_rename_dialog(credential_name, function (new_name, finalize_callback) {
            fido2_rename(credential_id, new_name,
                function () {
                    fido2_table.appendGrid("setCtrlValue", "credential_name", rowIndex, new_name);
                    finalize_callback();
                },
                function () {
                    finalize_callback();
                }
            );
        });
    }
});

fido2_table_customRowButtons.push({
    uiButton: { icons: { primary: "ui-icon-minus" }, text: false },
    btnAttr: { title: "Remove the credential" },
    atTheFront: true,
    click: function (evt, uniqueIndex, rowData) {
        var credential_id = fido2_table.appendGrid("getCtrlValue", "credential_id", fido2_table.appendGrid("getRowIndex", uniqueIndex));
        var fido2_remove_confirm_dialog = $("div#fido2_remove_confirm");
        fido2_remove_confirm_dialog.dialog({autoOpen: false, resizable: false, width: 400, height: 200, modal: true,
            buttons: {
                "Proceed to remove": function () {
                    fido2_remove(credential_id,
                        function () {
                            fido2_table.appendGrid("removeRow", fido2_table.appendGrid("getRowIndex", uniqueIndex));
                            fido2_remove_confirm_dialog.dialog("close");
                        },
                        function () {
                            fido2_remove_confirm_dialog.dialog("close");
                        }
                    );
                },
                Cancel: function () {
                    fido2_remove_confirm_dialog.dialog("close");
                }
            }
        });
        fido2_remove_confirm_dialog.dialog("open");
    }
});

// init FIDO2 credentials table
fido2_table.appendGrid({
    columns: [
        {type: "hidden", name: "credential_id"},
        {name: "credential_name", display: "Name", displayCss: {"min-width": "8em", "width": "18em"}, resizable: true, ctrlProp: {readonly: true, maxLength: 128}},
        {name: "credential_aaguid", display: "AAGUID", displayCss: {"min-width": "8em", "width": "18em"}, resizable: true, ctrlProp: {readonly: true}},
    ],
    i18n: {
        rowEmpty: "No FIDO2 credentials"
    },
    initRows: 0,
    hideRowNumColumn: true,
    customRowButtons: fido2_table_customRowButtons,
    hideButtons: { moveUp: true, moveDown: true, insert: true, removeLast: true, append: true, remove: true }
});

// append FIDO2 credentials data to the table
{{ fido2_list|default([])|json }}.forEach(function (credential) {
    fido2_table.appendGrid("appendRow", [{
        credential_id: credential.id,
        credential_name: credential.name || "Security key",
        credential_aaguid: credential.aaguid
    }]);
});

});
//]]> raw script end
</script>

<div class="ext_auth_google">
<h3>Auth Ext - Google</h3>
{% if google_email_list|default([])|length > 0 -%}
<table>
{% for google_email in google_email_list %}
<tr><td>{{ google_email|e }}</td></tr>
{% endfor %}
</table>
{%- else -%}
<p>No accounts linked.</p>
{%- endif %}
</div>

<div class="role">
<h3>Roles</h3>
<form action="">
{% if roles|length > 0 %}
<table>
<thead><tr><th>Role</th><th>flag</th></tr></thead><tbody>
{% for role, role_active in roles %}
<tr>
<td>{{ role['name']|default('<no name>')|e }}</td>
<td><input type="checkbox" {{ {'name': 'role_%s' % role['uuid'].hex, 'value': '1'}|xmlattr }} {% if role_active%}checked="checked"{% endif %} disabled="disabled" /></td>
</tr>
{% endfor %}
</tbody>
</table>
{% else %}
<p>No roles.</p>
{% endif %}
</form>
</div>

{% else %}
<h3>Auth Ext - Gooogle</h3>
<p><a {{ {'href': google_auth_url}|xmlattr }}>Proceed to Google authentication</a></p>
<h3>FIDO2</h3>
<p><button type="button" id="fido2_auth">Authenticate with FIDO2</button></p>
<script>
// raw script begin <![CDATA[
function fido2_decode(value) {
    const padded = value + "=".repeat((4 - value.length % 4) % 4);
    const binary = atob(padded.replace(/-/g, "+").replace(/_/g, "/"));
    return Uint8Array.from(binary, character => character.charCodeAt(0));
}
function fido2_encode(value) {
    const bytes = new Uint8Array(value);
    let binary = "";
    for (const byte of bytes) binary += String.fromCharCode(byte);
    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}
$("#fido2_auth").click(function () {
    var options = {{ fido2_auth_options|tojson }};
    options.challenge = fido2_decode(options.challenge);
    if (options.allowCredentials) options.allowCredentials.forEach(function (c) {
        c.id = fido2_decode(c.id);
    });
    navigator.credentials.get({publicKey: options}).then(function (credential) {
        var response = credential.response;
        var encode = fido2_encode;
        $.ajax({method: "POST", url: "/auth/ext/fido2", contentType: "application/json",
            data: JSON.stringify({id: credential.id, response: {clientDataJSON: encode(response.clientDataJSON), authenticatorData: encode(response.authenticatorData), signature: encode(response.signature), userHandle: response.userHandle ? encode(response.userHandle) : null}}),
            success: function () { window.location = "/auth/user"; }});
    });
});
//]]> raw script end
</script>
{% endif %}
{%- endblock %}
