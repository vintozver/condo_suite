{% extends "skeleton" %}
{% block body_content %}
<h1>{{ title|e }}</h1>
<p>Status: {{ status|e }}</p>
<form {{ {'action': '/case/amend/%s'|format(oid)}|xmlattr }} method="post">
<input type="hidden" name="action" value="status" />
<select name="status"><option>open</option><option>progress</option><option>resolved</option><option>closed</option></select>
<input type="submit" value="Change status" />
</form>
<h3>History</h3>
{% for item in history %}
<p><strong>{{ item.dt|datetime('%Y-%m-%d %H:%M') }}</strong> {{ item.comment|e }}</p>
{% endfor %}
<form {{ {'action': '/case/amend/%s'|format(oid)}|xmlattr }} method="post" enctype="multipart/form-data">
<p><textarea name="comment" rows="4" cols="80"></textarea></p>
<p>File <input type="file" name="attachment" /></p>
<input type="submit" value="Add comment" />
</form>
<form {{ {'action': '/case/amend/%s'|format(oid)}|xmlattr }} method="post">
<input type="hidden" name="action" value="link" />
<p>Link case <input type="text" name="linked_case" /></p>
<p>Comment <input type="text" name="comment" /></p>
<input type="submit" value="Link case" />
</form>
{% endblock %}
